{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo skip",
  "buildCommand": "echo skip",
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,vercel.json,.vercelignore,public/packages/**,public/dashboard-icons/**,storage/logs/**,database/seeders/Transfers/**,vendor/**/tests/**,vendor/**/Tests/**,vendor/**/docs/**,vendor/**/samples/**}"
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
